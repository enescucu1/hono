meta {
  name: Token als admin
  type: http
  seq: 1
}

post {
  url: {{tokenUrl}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "admin",
    "password": "p"
  }
}

assert {
  res.status: eq 200
  res.headers['content-type']: contains application/json
  res.body.access_token: matches .+\..+\..+
  res.body.expires_in: eq 1800
  res.body.refresh_expires_in: eq 3600
}

docs {
  Der Server holt den Access Token bei Keycloak (`POST /auth/token`, der Dozent nutzt die Methode QUERY).
}
