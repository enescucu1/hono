meta {
  name: Token ohne Benutzername
  type: http
  seq: 4
}

post {
  url: {{tokenUrl}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "",
    "password": "p"
  }
}

assert {
  res.status: eq 422
  res.body.statusCode: eq 422
  res.body.detail.fieldErrors.username: isDefined
}

docs {
  Der Server holt den Access Token bei Keycloak (`POST /auth/token`, der Dozent nutzt die Methode QUERY).
}
