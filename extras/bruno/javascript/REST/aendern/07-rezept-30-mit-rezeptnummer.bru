meta {
  name: Rezept 30 mit Rezeptnummer im Body aendern
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/rest/30
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  If-Match: {{etag}}
}

body:json {
  {
    "rezeptnummer": "RZ-999",
    "bewertung": 5,
    "schwierigkeit": "SCHWER",
    "kosten": 33.33,
    "zubereitungszeit": 35,
    "vegetarisch": true,
    "titel": { "titel": "Tomatensuppe neu" },
    "zutaten": [
      { "bezeichnung": "Tomaten", "menge": 900, "einheit": "g" },
      { "bezeichnung": "Sahne", "menge": 100, "einheit": "ml" }
    ]
  }
}

assert {
  res.status: eq 422
}

docs {
  Die Rezeptnummer ist unveraenderlich, sie darf im Body nicht stehen.
}
