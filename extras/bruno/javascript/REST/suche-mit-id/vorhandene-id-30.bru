meta {
  name: Vorhandene ID 30 (merkt den ETag)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/rest/30
  body: none
  auth: none
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("etag", res.getHeader("etag"));
  }
}

assert {
  res.status: eq 200
  res.body.id: eq 30
  res.headers.etag: isString
}

docs {
  Merkt den ETag (Versionsnummer in Anfuehrungszeichen) in der Variable `etag`.
  Die PUT-Requests im Ordner `Aendern` benutzen ihn als `If-Match`.
}
