meta {
  name: Neues Rezept ohne JSON im Body (400)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/rest
  body: text
  auth: inherit
}

headers {
  Content-Type: text/plain
}

body:text {
  das ist kein json
}

assert {
  res.status: eq 400
  res.body.title: eq Bad Request
}

docs {
  Der Body ist kein JSON. Der Header ist text/plain, weil der HTTP-Client von Bruno bei application/json einen
  ungueltigen Text selbst als JSON-String verpackt, dann waere der Body gueltiges JSON und die Antwort 422.
}
