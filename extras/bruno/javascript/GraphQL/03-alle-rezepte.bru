meta {
  name: Alle Rezepte (Zutaten werden nachgeladen)
  type: graphql
  seq: 3
}

post {
  url: {{baseUrl}}/graphql
  body: graphql
  auth: none
}

body:graphql {
  query {
    rezepte {
      id
      titel { titel }
      zutaten { bezeichnung }
    }
  }
}

assert {
  res.status: eq 200
  res.body.data.rezepte.length: eq 5
  res.body.data.rezepte[0].zutaten.length: gte 1
}

