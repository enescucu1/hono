meta {
  name: Rezept loeschen als user (Mutation)
  type: graphql
  seq: 18
}

post {
  url: {{baseUrl}}/graphql
  body: graphql
  auth: oauth2
}

auth:oauth2 {
  grant_type: password
  access_token_url: {{oidcTokenUrl}}
  refresh_token_url: 
  username: user
  password: p
  client_id: {{clientId}}
  client_secret: {{clientSecret}}
  scope: 
  credentials_placement: body
  credentials_id: user
  token_placement: header
  token_header_prefix: Bearer
  auto_fetch_token: true
  auto_refresh_token: false
}

body:graphql {
  mutation {
    delete(id: {{gqlUpdateId}}) {
      success
    }
  }
}

assert {
  res.status: eq 200
  res.body.errors[0].extensions.code: eq FORBIDDEN
}

docs {
  Loeschen darf nur die Rolle `admin`.
}
