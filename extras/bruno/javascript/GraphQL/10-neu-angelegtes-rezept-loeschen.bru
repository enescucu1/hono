meta {
  name: Neu angelegtes Rezept loeschen (REST)
  type: http
  seq: 10
}

auth:oauth2 {
  grant_type: password
  access_token_url: {{oidcTokenUrl}}
  refresh_token_url: 
  username: {{username}}
  password: {{password}}
  client_id: {{clientId}}
  client_secret: {{clientSecret}}
  scope: 
  credentials_placement: body
  credentials_id: credentials
  token_placement: header
  token_header_prefix: Bearer
  auto_fetch_token: true
  auto_refresh_token: false
}

delete {
  url: {{baseUrl}}/rest/{{graphqlId}}
  body: none
  auth: oauth2
}

assert {
  res.status: eq 204
}

docs {
  Raeumt das Rezept aus `Neues Rezept (Mutation)` per REST auf, damit die Requests wiederholbar sind.
}
