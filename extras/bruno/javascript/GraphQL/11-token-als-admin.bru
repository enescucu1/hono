meta {
  name: Token als admin (Mutation)
  type: graphql
  seq: 11
}

post {
  url: {{baseUrl}}/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation {
    token(username: "admin", password: "p") {
      access_token
      expires_in
      refresh_expires_in
    }
  }
}

assert {
  res.status: eq 200
  res.body.data.token.access_token: matches .+\..+\..+
  res.body.data.token.expires_in: gte 1790
  res.body.data.token.expires_in: lte 1800
}
